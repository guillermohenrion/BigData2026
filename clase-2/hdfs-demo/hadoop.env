# Configuración para las imágenes bde2020.
# Convención de nombres: "___" -> "-", "__" -> "_", "_" -> "."
#   HDFS_CONF_dfs_replication=3  ->  dfs.replication=3 en hdfs-site.xml
CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_replication=3

# --- Ajustes para que la demo sea visible en clase ---
# Por defecto un DataNode se declara muerto a los ~10.5 min (2 x 5min + 10 x 3s).
# Con recheck=10s queda en 2 x 10s + 10 x 3s = ~50 s.
HDFS_CONF_dfs_namenode_heartbeat_recheck___interval=10000
HDFS_CONF_dfs_heartbeat_interval=3
# Marca el nodo como "stale" a los 15 s y evita leer de él.
HDFS_CONF_dfs_namenode_stale_datanode_interval=15000
HDFS_CONF_dfs_namenode_avoid_read_stale_datanode=true
# La imagen bde2020, con MULTIHOMED_NETWORK=1 (default), fuerza
# dfs.client.use.datanode.hostname=true. Con un contenedor apagado su hostname deja de
# resolver y el cliente 3.2.1 aborta la lectura (UnresolvedAddressException) en vez de
# pasar a otra réplica. Con IPs falla con "connection refused" y sí reintenta.
# Lo desactivamos y declaramos a mano los bind hosts que esa opción configuraba.
MULTIHOMED_NETWORK=0
HDFS_CONF_dfs_namenode_rpc___bind___host=0.0.0.0
HDFS_CONF_dfs_namenode_servicerpc___bind___host=0.0.0.0
HDFS_CONF_dfs_namenode_http___bind___host=0.0.0.0
HDFS_CONF_dfs_namenode_https___bind___host=0.0.0.0
